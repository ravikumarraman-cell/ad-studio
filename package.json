{
  "name": "autodev-studio",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@tanstack/react-start-client": "1.120.0",
    "@tanstack/react-start-config": "1.120.0",
    "@tanstack/react-start-server": "1.120.0",
    "@tanstack/start-api-routes": "1.119.0",
    "@tanstack/react-start-router-manifest": "1.119.0",
    "@tanstack/start-server-functions-client": "1.119.2",
    "@tanstack/start-server-functions-server": "1.119.2",
    "@tanstack/start-server-functions-ssr": "1.119.2",
    "@tanstack/start-server-functions-handler": "1.119.0",
    "@tanstack/react-router": "1.120.0",
    "@tanstack/router-core": "1.119.0",
    "@tanstack/history": "1.115.0",
    "@tanstack/start-client-core": "1.119.0",
    "@tanstack/start-server-core": "1.119.0",
    "@tanstack/router-plugin": "1.120.0",
    "@tanstack/router-generator": "1.120.0",
    "@tanstack/react-start-plugin": "1.115.0",
    "@tanstack/server-functions-plugin": "1.119.2",
    "@tanstack/start-server-functions-fetcher": "1.119.0"
  },
  "scripts": {
    "dev": "npm --workspace=adx-health-authorization-demo run dev",
    "verify:stage0": "node scripts/verify-stage0.mjs",
    "verify:stage1": "node scripts/verify-stage1.mjs",
    "verify:stage2": "node scripts/verify-stage2.mjs",
    "migrate:stage2": "node scripts/migrate-stage2.mjs",
    "verify:stage2:postgres": "node scripts/verify-stage2-postgres.mjs",
    "verify:stage2:api": "node scripts/verify-stage2-api.mjs",
    "verify:stage3": "node scripts/verify-stage3.mjs",
    "verify:stage3:api": "node scripts/verify-stage3-api.mjs",
    "verify:stage4": "node scripts/verify-stage4.mjs",
    "verify:stage4:api": "node scripts/verify-stage4-api.mjs",
    "verify:stage5": "node scripts/verify-stage5.mjs",
    "verify:stage5:api": "node scripts/verify-stage5-api.mjs",
    "verify:stage5:sandbox": "node scripts/verify-stage5-sandbox.mjs",
    "verify:stage5:docker-sandbox": "node scripts/verify-stage5-docker-sandbox.mjs",
    "verify:stage5:adversarial": "node scripts/verify-stage5-docker-sandbox.mjs",
    "verify:stage6": "node scripts/verify-stage6.mjs",
    "verify:stage6:api": "node scripts/verify-stage6-api.mjs",
    "verify:stage6:object-store": "node scripts/verify-stage6-object-store.mjs",
    "verify:stage7": "node scripts/verify-stage7.mjs",
    "verify:stage7:api": "node scripts/verify-stage7-api.mjs",
    "verify:stage7:providers": "node scripts/verify-stage7-providers.mjs",
    "verify:stage8": "node scripts/verify-stage8.mjs",
    "verify:stage8:postgres": "node scripts/verify-stage8-postgres.mjs",
    "verify:stage8:adapters": "node scripts/verify-stage8-adapters.mjs",
    "verify:stage8:reconciliation": "node scripts/verify-stage8-reconciliation.mjs",
    "verify:stage8:game-day": "node scripts/verify-stage8-game-day.mjs",
    "verify:stage8:integration-config": "node scripts/verify-stage8-integration-config.mjs",
    "validate:stage8:integration": "node scripts/validate-stage8-integration.mjs",
    "verify:stage9": "node scripts/verify-stage9.mjs",
    "verify:stage9:postgres": "node scripts/verify-stage9-postgres.mjs",
    "verify:stage9:evaluation": "node scripts/verify-stage9-evaluation.mjs",
    "verify:stage9:coupling": "node scripts/verify-stage9-coupling.mjs",
    "verify:stage10": "node scripts/verify-stage10.mjs",
    "verify:stage10:postgres": "node scripts/verify-stage10-postgres.mjs",
    "verify:coding-agent-adapters": "node scripts/verify-coding-agent-adapters.mjs",
    "verify:feature-import": "node scripts/verify-feature-import.mjs",
    "verify:maintainability": "node scripts/verify-maintainability.mjs",
    "bootstrap:stage0": "bash scripts/bootstrap-stage0.sh",
    "api:dev": "npm --workspace=@adx/api run dev",
    "provision:local-user": "node scripts/provision-local-user.mjs",
    "api:smoke": "npm --workspace=@adx/api run smoke",
    "canary:smoke": "node scripts/verify-canary-smoke.mjs",
    "typecheck:domain": "apps/health-authorization-demo/node_modules/.bin/tsc -p packages/domain/tsconfig.json",
    "typecheck": "npm run verify:stage0 && npm run verify:feature-import && npm run typecheck:domain && npm --prefix apps/health-authorization-demo run typecheck",
    "build": "npm run typecheck && npm --prefix apps/health-authorization-demo run build"
  }
}
