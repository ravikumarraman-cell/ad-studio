# Local-only Stage 1 identity and persistence configuration.
# Copy to .env.local; never commit .env.local or any secret.
ADX_OIDC_ISSUER=https://accounts.google.com
ADX_OIDC_AUDIENCE=558100690537-p5jpl96tj7as9u763t8codnl9hj9u60t.apps.googleusercontent.com
ADX_OIDC_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
ADX_OIDC_CLIENT_SECRET=
ADX_OIDC_REDIRECT_URI=http://127.0.0.1:3100/auth/callback
# Where the browser should land after a successful OIDC callback. The API
# session cookie remains HttpOnly; use the public HTTPS UI origin when deployed.
ADX_UI_ORIGIN=http://127.0.0.1:4173/

# Optional model-backed story suggestions. These values are read only by the
# ADX API process; never expose the key through Vite or browser variables.
# Leave both empty to keep AI suggestions disabled while retaining manual
# story authoring. Use a model your OpenAI project has enabled.
ADX_STORY_AI_API_KEY=
ADX_STORY_AI_MODEL=
DATABASE_URL=postgresql://adx:adx_local_only@127.0.0.1:5432/adx

# Stage 2 ledger attestation. Prefer protected PEM files; never commit them.
ADX_LEDGER_SIGNING_KEY_ID=adx-local-ed25519-1
ADX_LEDGER_SIGNING_PRIVATE_KEY_FILE=.adx-ledger-private.pem
ADX_LEDGER_SIGNING_PUBLIC_KEY_FILE=.adx-ledger-public.pem

# Stage 8 non-production integration profile. Keep disabled until the named
# staging environment, provider owners, rollback artifact, and webhook secret
# have been approved. These are placeholders, not working provider settings.
ADX_RELEASE_INTEGRATION_ENABLED=false
ADX_RELEASE_ENVIRONMENT=staging
ADX_RELEASE_DEPLOYMENT_PROVIDER=
ADX_RELEASE_DEPLOYMENT_ENDPOINT=
ADX_RELEASE_FLAG_PROVIDER=
ADX_RELEASE_FLAG_KEY=
ADX_RELEASE_TELEMETRY_PROVIDER=
ADX_RELEASE_TELEMETRY_ENDPOINT=
ADX_RELEASE_TELEMETRY_QUERY=
ADX_RELEASE_WEBHOOK_SECRET=
ADX_RELEASE_ROLLBACK_ARTIFACT_DIGEST=
